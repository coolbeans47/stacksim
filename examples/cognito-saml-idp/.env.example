# Browser-visible stacksim Cognito origin.
STACKSIM_COGNITO_PUBLIC_URL=http://localhost:4566

# stacksim control-plane endpoint and Region used by npm run setup:cognito.
STACKSIM_ENDPOINT=http://127.0.0.1:4566
AWS_REGION=eu-west-1

# Browser-visible Paper Badge origin and server-side SAML metadata URL.
SAML_IDP_BASE_URL=http://localhost:5174
SAML_IDP_METADATA_URL=http://127.0.0.1:5174/saml/metadata

# Optional resource names.
COGNITO_POOL_NAME=saml-learning-pool
COGNITO_PROVIDER_NAME=LearningSAML
COGNITO_CLIENT_NAME=saml-learning-client
COGNITO_DOMAIN=saml-learning-local

# The local IdP server port.
PORT=5174
