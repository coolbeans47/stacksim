{
  "name": "stacksim-aurora-atlas-showcase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A broad full-stack CDK showcase for services implemented by stacksim",
  "scripts": {
    "build:frontend": "node frontend/build.mjs",
    "synth": "cdk synth --no-notices",
    "verify:assembly": "node scripts/verify-assembly.mjs",
    "build": "npm run build:frontend && npm run synth && npm run verify:assembly",
    "deploy": "node scripts/deploy.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "capture": "node scripts/capture.mjs",
    "destroy": "cdk destroy --all --force"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.848.0",
    "@aws-sdk/client-eventbridge": "3.848.0",
    "@aws-sdk/client-sqs": "3.848.0",
    "aws-cdk-lib": "2.261.0",
    "constructs": "10.7.1",
    "lucide-react": "^0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "autoprefixer": "10.4.21",
    "aws-cdk": "2.1132.0",
    "esbuild": "0.28.1",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.0",
    "typescript": "5.8.3"
  }
}
