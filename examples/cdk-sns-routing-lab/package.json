{
  "name": "stacksim-sns-routing-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An SNS-first CDK tutorial and interactive routing showcase for stacksim",
  "scripts": {
    "build:frontend": "node frontend/build.mjs",
    "synth": "cdk synth --no-notices",
    "verify:assembly": "node scripts/verify-assembly.mjs",
    "build": "npm run build:frontend && npm run synth && npm run verify:assembly",
    "deploy": "node scripts/deploy.mjs",
    "seed": "node scripts/seed.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "destroy": "cdk destroy --all --force"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "aws-cdk-lib": "2.265.0",
    "constructs": "10.7.1",
    "lucide-react": "^0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "aws-cdk": "2.1132.0",
    "esbuild": "0.28.1",
    "tsx": "4.20.0",
    "typescript": "5.8.3"
  }
}
