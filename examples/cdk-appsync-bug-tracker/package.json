{
  "name": "stacksim-cdk-appsync-bug-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:frontend": "node frontend/build.mjs",
    "synth": "cdk synth --no-notices",
    "verify:assembly": "node scripts/verify-assembly.mjs",
    "build": "npm run build:frontend && npm run synth && npm run verify:assembly",
    "deploy": "node scripts/deploy.mjs",
    "seed": "node scripts/seed.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:visual": "node scripts/visual.mjs",
    "destroy": "cdk destroy --all --force --no-notices"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "@aws-sdk/client-appsync": "3.1097.0",
    "@aws-sdk/client-dynamodb": "3.1097.0",
    "@aws-sdk/client-s3": "3.1097.0",
    "aws-cdk-lib": "2.261.0",
    "constructs": "10.7.1",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "aws-cdk": "2.1132.0",
    "esbuild": "0.28.1",
    "tsx": "4.20.0",
    "typescript": "5.8.3"
  }
}
