    "fsevents@2.3.3": true,
    "core-js@2.6.12": true,
    "esbuild@0.28.1": true,
    "core-js@3.49.0": true
  },
  "dependencies": {
    "aws-amplify": "6.20.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.8.0",
    "@aws-amplify/backend-cli": "1.9.0",
    "@vitejs/plugin-react": "6.0.4",
    "aws-cdk-lib": "2.265.0",
    "typescript": "7.0.2",
    "vite": "8.1.5"
