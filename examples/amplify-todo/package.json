{
  "name": "stacksim-amplify-gen2-data-fixture",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A deployment-ready React Todo example for StackSim and Amplify Gen 2 Data",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "node scripts/ampx-local.mjs sandbox --once --identifier amx01",
    "backend:watch": "node scripts/ampx-local.mjs sandbox --identifier amx01",
