{
  "name": "stacksim-s3-lambda-notification-audit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An educational CDK example that records direct S3 Lambda notifications in DynamoDB",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "synth": "cdk synth --no-notices",
    "verify:assembly": "node scripts/verify-assembly.mjs",
    "build": "npm run typecheck && npm test && npm run synth && npm run verify:assembly",
    "deploy": "cdk deploy S3LambdaNotificationAuditStack --require-approval never --outputs-file .runtime/outputs.json --no-notices",
    "demo": "node scripts/demo.mjs",
    "show-events": "node scripts/show-events.mjs",
    "destroy": "cdk destroy S3LambdaNotificationAuditStack --force --no-notices"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1086.0",
    "@aws-sdk/client-s3": "^3.1089.0",
    "aws-cdk-lib": "2.265.0",
    "constructs": "10.7.1"
  },
  "devDependencies": {
    "aws-cdk": "2.1132.0",
    "tsx": "4.20.0",
    "typescript": "5.8.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
