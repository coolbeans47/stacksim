                [
                  {
                    "Fn::GetAtt": [
                      "FilesBucket759C181F",
                      "Arn"
                    ]
                  },
                  "/*"
                ]
              ]
            }
          ]
        }
      ],
      "Version": "2012-10-17"
    }
  }
