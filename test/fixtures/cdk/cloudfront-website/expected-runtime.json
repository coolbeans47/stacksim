{
  "schemaVersion": 1,
  "runtimeConfig": {
    "stage": "test",
    "region": "eu-west-1",
    "userPoolId": "eu-west-1_FIXTURE",
    "userPoolClientId": "fixture-spa-client",
    "apiBaseUrl": "https://fixtureapi01.execute-api.eu-west-1.amazonaws.com/fixture-v1/v1"
  },
  "securityHeaders": {
    "content-security-policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self' https://fixtureapi01.execute-api.eu-west-1.amazonaws.com https://cognito-idp.eu-west-1.amazonaws.com",
    "x-content-type-options": "nosniff",
    "x-frame-options": "DENY",
    "referrer-policy": "strict-origin-when-cross-origin",
    "strict-transport-security": "max-age=31536000; includeSubDomains; preload"
  },
  "viewerRoutes": [
    { "path": "/", "behavior": "default", "function": true, "originPath": "/index.html", "cache": "disabled" },
    { "path": "/shipments/42", "behavior": "default", "function": true, "originPath": "/index.html", "cache": "disabled" },
    { "path": "/settings/", "behavior": "default", "function": true, "originPath": "/index.html", "cache": "disabled" },
    { "path": "/assets/app.js", "behavior": "assets/*", "function": false, "originPath": "/assets/app.js", "cache": "optimized", "compress": true },
    { "path": "/runtime-config.json", "behavior": "runtime-config.json", "function": false, "originPath": "/runtime-config.json", "cache": "disabled" }
  ],
  "deployment": {
    "applicationCacheControl": "no-cache",
    "assetCacheControl": "public,max-age=31536000,immutable",
    "invalidationPaths": ["/*"],
    "retainOnDelete": true,
    "wholePrefixPrune": true
  },
  "canonicalDomainPattern": "^d[a-z0-9]+\\.cloudfront\\.net$",
  "localViewerPattern": "^https://d[a-z0-9]+\\.localhost:[0-9]+/$"
}

