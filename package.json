{
  "name": "stacksim",
  "version": "0.1.0",
  "private": true,
  "description": "StackSim: a persistent local learning environment compatible with selected AWS APIs and AWS SDK v3",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/src/cli.js",
    "start:amplify": "node dist/src/cli.js --appsync-local-tls",
    "dev": "tsx src/cli.ts",
    "generate:cloudwatch-insights-capabilities": "node scripts/generate-cloudwatch-logs-insights-capabilities.mjs",
    "check:cloudwatch-insights-capabilities": "node scripts/generate-cloudwatch-logs-insights-capabilities.mjs --check",
    "check:structured-arn-inputs": "node scripts/check-structured-arn-inputs.mjs",
    "package:sample": "npm run build && tsc -p tsconfig.lambda.json && node scripts/package-lambda.mjs",
    "seed": "npm run package:sample && node dist/examples/deploy.js",
    "seed:rds-stream": "npm run package:sample && node dist/examples/rds-stream/deploy.js",
    "test": "npm run test:node && npm run test:browser",
    "pretest:node": "npm ci --prefix test/fixtures/amplify-gen2-data --no-audit --no-fund",
    "test:node": "npm run build && tsc -p tsconfig.lambda.json && node scripts/package-lambda.mjs && node --test --test-concurrency=4 dist/test/*.test.js",
    "pretest:browser": "tsc -p tsconfig.lambda.json && node scripts/package-lambda.mjs",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "@aws-sdk/checksums": "^3.1000.18",
    "@aws-sdk/client-api-gateway": "^3.848.0",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1089.0",
    "@aws-sdk/client-apigatewayv2": "^3.1089.0",
    "@aws-sdk/client-appsync": "3.1097.0",
    "@aws-sdk/client-cloudformation": "3.1079.0",
    "@aws-sdk/client-cloudwatch": "^3.1087.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1086.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1094.0",
    "@aws-sdk/client-dynamodb": "^3.848.0",
    "@aws-sdk/client-dynamodb-streams": "^3.1088.0",
    "@aws-sdk/client-eventbridge": "^3.1090.0",
    "@aws-sdk/client-iam": "^3.1087.0",
    "@aws-sdk/client-lambda": "^3.848.0",
    "@aws-sdk/client-rds": "^3.1090.0",
    "@aws-sdk/client-s3": "^3.1089.0",
    "@aws-sdk/client-s3-control": "^3.1095.0",
    "@aws-sdk/client-scheduler": "^3.1095.0",
    "@aws-sdk/client-secrets-manager": "3.1096.0",
    "@aws-sdk/client-ses": "^3.1093.0",
    "@aws-sdk/client-sesv2": "^3.1093.0",
    "@aws-sdk/client-sfn": "3.1090.0",
    "@aws-sdk/client-sns": "3.1095.0",
    "@aws-sdk/client-sqs": "^3.1090.0",
    "@aws-sdk/client-ssm": "^3.1079.0",
    "@aws-sdk/client-sts": "^3.1087.0",
    "@aws-sdk/lib-dynamodb": "^3.1086.0",
    "@aws-sdk/lib-storage": "^3.1089.0",
    "@aws-sdk/s3-request-presigner": "^3.1089.0",
    "@aws/durable-execution-sdk-js": "^2.1.0",
    "@playwright/test": "^1.61.1",
    "@smithy/signature-v4": "5.6.10",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "aws-cdk-lib": "2.261.0",
    "cdk": "2.1132.0",
    "constructs": "10.7.1",
    "esbuild": "0.28.1",
    "hash-wasm": "^4.12.0",
    "knex": "3.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sequelize": "6.37.8",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "ws": "^8.21.1"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "@xmldom/xmldom": "0.9.10",
    "graphql": "17.0.2",
    "handlebars": "4.7.9",
    "mysql2": "^3.23.1",
    "re2js": "2.8.5",
    "xml-crypto": "6.1.2"
  }
}
